#!/bin/sh
#
# Gradle start up script for POSIX generated by Gradle 8.9
#
set -e

APP_HOME=$( cd "${0%/*}" && pwd -P ) || exit

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use installed gradle if gradle-wrapper.jar is not present yet
if [ ! -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
  if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
  elif [ -x "/opt/gradle/gradle-8.9/bin/gradle" ]; then
    exec /opt/gradle/gradle-8.9/bin/gradle "$@"
  else
    echo "ERROR: gradle-wrapper.jar not found and system gradle is not in PATH." >&2
    exit 1
  fi
fi

if [ -n "$JAVA_HOME" ] ; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
