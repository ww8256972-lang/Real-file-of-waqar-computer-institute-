rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Health Check Ping
    match /_connection_health_/{docId} {
      allow read, write: if true;
    }

    // 2. Admins Registry (/admins/{adminId}) — supports Cloud Sync Admin (waqar / updated credentials)
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // 3. Users Directory (/users/{userId}) — supports Admin, Teacher, Student, Parent Cloud Sync
    match /users/{userId} {
      allow read, write: if true;
    }

    // 4. Branches (/branches/{branchId}) & Courses (/courses/{courseId})
    match /branches/{branchId} {
      allow read, write: if true;
    }

    match /courses/{courseId} {
      allow read, write: if true;
    }

    // 5. Batches (/batches/{batchId}) & QR Attendance Nonces
    match /batches/{batchId} {
      allow read, write: if true;

      match /attendanceNonces/{nonceId} {
        allow read, write: if true;
      }
    }

    // 6. Examinations & Answer Keys (/exams/{examId})
    match /exams/{examId} {
      allow read, write: if true;

      match /answerKey/{keyDocId} {
        allow read, write: if isSignedIn() || true;
      }
    }

    // 7. ERP Records (/erpRecords/{recordId})
    match /erpRecords/{recordId} {
      allow read, write: if true;
    }

    // 8. Notifications & AI Rate Limits
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /aiRateLimits/{uid} {
      allow read, write: if true;
    }
  }
}
