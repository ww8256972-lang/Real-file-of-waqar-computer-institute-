# GEMINI_API_KEY: Required for Gemini 3.8 Flash AI API calls (Server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional ChatGPT OpenAI API Key for AI Tutor (Server-side fallback/dual engine)
OPENAI_API_KEY="MY_OPENAI_CHATGPT_API_KEY"
OPENAI_MODEL="gpt-4o-mini"

# AGORA_APP_ID: Optional Agora Real-Time Video/Voice App ID for Live Online Classes
AGORA_APP_ID="MY_AGORA_APP_ID"
VITE_AGORA_APP_ID="MY_AGORA_APP_ID"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
