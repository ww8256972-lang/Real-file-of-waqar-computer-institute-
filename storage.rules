rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{fileName} {
      allow read, write: if true;
    }
    match /students/{studentId}/{fileName} {
      allow read, write: if true;
    }
    match /institute/{module}/{fileName} {
      allow read, write: if true;
    }
  }
}
