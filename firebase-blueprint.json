{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Cloud-synced account profile for Admin, Teacher, Student, and Parent portals",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "student", "parent", "accountant", "receptionist"] },
        "linkedEntityId": { "type": "string" },
        "branchId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "passwordSalt": { "type": "string" },
        "passwordVerifierHash": { "type": "string" }
      },
      "required": ["uid", "username", "role", "branchId", "status"]
    },
    "BranchDoc": {
      "title": "BranchDoc",
      "description": "Institute campus branch record",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "managerName": { "type": "string" },
        "status": { "type": "string" },
        "ownerUid": { "type": "string" },
        "visibility": { "type": "string" }
      },
      "required": ["code", "name", "status"]
    },
    "CourseDoc": {
      "title": "CourseDoc",
      "description": "Academic computer course offering",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "string" },
        "fee": { "type": "number" },
        "syllabus": { "type": "string" },
        "description": { "type": "string" },
        "branchId": { "type": "string" },
        "status": { "type": "string" },
        "ownerUid": { "type": "string" },
        "visibility": { "type": "string" }
      },
      "required": ["code", "name", "fee"]
    },
    "BatchDoc": {
      "title": "BatchDoc",
      "description": "Classroom batch schedule and faculty assignment",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "branchId": { "type": "string" },
        "timing": { "type": "string" },
        "capacity": { "type": "number" },
        "startDate": { "type": "string" },
        "status": { "type": "string" },
        "ownerUid": { "type": "string" },
        "visibility": { "type": "string" }
      },
      "required": ["code", "name", "courseId"]
    },
    "ErpRecordDoc": {
      "title": "ErpRecordDoc",
      "description": "Unified ERP record for students, attendance, exams, results, fees, certificates, and notices",
      "type": "object",
      "properties": {
        "module": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "branchId": { "type": "string" },
        "courseId": { "type": "string" },
        "batchId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "numericValue": { "type": "number" },
        "secondaryNumericValue": { "type": "number" },
        "dateStr": { "type": "string" },
        "notes": { "type": "string" },
        "extra1": { "type": "string" },
        "extra2": { "type": "string" },
        "extra3": { "type": "string" },
        "extra4": { "type": "string" },
        "ownerUid": { "type": "string" },
        "visibility": { "type": "string" }
      },
      "required": ["module", "code", "title"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Cloud-synced Administrator credentials and profile"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Cloud-synced user profiles for Admin, Teacher, Student, and Parent"
    },
    "/branches/{branchId}": {
      "schema": { "$ref": "#/entities/BranchDoc" },
      "description": "Institute branches"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/CourseDoc" },
      "description": "Institute courses"
    },
    "/batches/{batchId}": {
      "schema": { "$ref": "#/entities/BatchDoc" },
      "description": "Institute batches"
    },
    "/erpRecords/{recordId}": {
      "schema": { "$ref": "#/entities/ErpRecordDoc" },
      "description": "All 19 ERP module records"
    }
  }
}
